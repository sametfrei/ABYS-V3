{
  "name": "abys-app",
  "version": "1.0.0",
  "description": "TAIS ABYS deterministic Windows desktop demo",
  "author": "TAIS",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "eval": "tsx evals/run-evals.mjs",
    "demo:tais:bootstrap": "tsx scripts/demo-tais-bootstrap.ts",
    "demo:tais:reset": "tsx scripts/demo-tais-reset.ts",
    "desktop:stage": "node scripts/build-desktop.mjs",
    "desktop:run": "electron .",
    "desktop:package": "npm run desktop:stage && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@google/genai": "^2.11.0",
    "clsx": "^2.1.1",
    "mammoth": "^1.12.0",
    "next": "^16.2.11",
    "papaparse": "^5.5.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.12",
    "sharp": "0.35.0"
  },
  "build": {
    "appId": "tr.com.tais.abys.demo",
    "productName": "TAIS ABYS",
    "asar": true,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/runtime/app-server",
        "to": "app-server"
      },
      {
        "from": "desktop/runtime/node",
        "to": "node"
      },
      {
        "from": ".env.example",
        "to": "config/.env.example"
      },
      {
        "from": "KURULUM-VE-GIRIS-BILGILERI.txt",
        "to": "KURULUM-VE-GIRIS-BILGILERI.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/abys.ico",
      "artifactName": "TAIS-ABYS-Desktop-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TAIS ABYS",
      "deleteAppDataOnUninstall": false
    }
  }
}
