# ABYS ortam değişkenleri örneği. Kopyala: cp .env.example .env.local
# GERÇEK sır/token YAZMA — aşağıdaki parola yalnızca deterministik demo hesabınındır.

# === Çalışma ortamı ===
AUTH_COOKIE_SECURE=false                  # localhost HTTP demo için false; HTTPS dağıtımında true
PORT=3000                                # Electron çalışma zamanında çakışmayan portu otomatik seçer

# === AI politikası (Core) ===
AI_POLICY=DEMO_DETERMINISTIC             # LOCAL_ONLY | CLOUD_ALLOWED | CLOUD_ONLY | DEMO_DETERMINISTIC
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
# GEMINI_API_KEY=                        # yalnızca CLOUD_* politikalarında

# === Veritabanı ===
# Varsayılan (boş): PGlite, dosya tabanlı gömülü Postgres (.data/abys-db).
#   Geliştirme/demo için; sistem servisi gerektirmez.
# ABYS_DB_DIR=.data/abys-db
#
# DATABASE_URL verilirse: gerçek PostgreSQL/PostGIS (Faz 1.5 üretim yolu).
#   src/lib/db/client.ts otomatik pg-adapter'a geçer. Ortamı ayağa kaldır:
#     docker compose up -d
# DATABASE_URL=postgres://abys:abys@localhost:5432/abys

# === PostgreSQL (docker-compose.disaster.yml) ===
# POSTGRES_USER=abys
# POSTGRES_PASSWORD=abys
# POSTGRES_DB=abys

# === Redis (Faz 2 bilimsel işler) ===
# REDIS_URL=redis://localhost:6379

# === Demo/Entegrasyon ===
# ABYS_PUBLIC_DEMO=0                      # 1: oturumsuz AI uçları (yalnızca demo)

# === TAIS demo bootstrap (npm run demo:tais:bootstrap) ===
ALLOW_TAIS_DEMO_BOOTSTRAP=false
TAIS_DEMO_ADMIN_EMAIL=ceo@tais.demo
TAIS_DEMO_ADMIN_PASSWORD=abys-demo-2026  # yalnızca belgelenmiş TAIS demo hesabı
ALLOW_TAIS_DEMO_RESET=false               # yerel production launcher bunu true yapar

# === Bitrix24 konnektörü (TAIS demo, src/lib/integrations/bitrix24) ===
BITRIX24_MODE=demo                        # demo | live — boşsa/tanımsızsa demo kabul edilir
# BITRIX24_BASE_URL=                      # https://<portal>.bitrix24.com — yalnızca live
# BITRIX24_WEBHOOK_TOKEN=                 # gelen (inbound) webhook için "userId/token" ya da doğrulama sırrı — GERÇEK DEĞER YAZMA
# BITRIX24_CLIENT_ID=                     # OAuth uygulama kimliği — yalnızca live
# BITRIX24_CLIENT_SECRET=                 # OAuth uygulama sırrı — GERÇEK DEĞER YAZMA
# BITRIX24_REFRESH_TOKEN=                 # OAuth yenileme jetonu — GERÇEK DEĞER YAZMA
# BITRIX24_FIELD_MAPPING_PATH=            # boşsa config/bitrix24-field-mapping.example.json kullanılır
